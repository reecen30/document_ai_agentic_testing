# LLM provider configuration
# Options: groq | openai | anthropic | ollama
AGENTIC_LLM_PROVIDER=groq

# Optional explicit base URL override for custom gateways/proxies.
# AGENTIC_LLM_BASE_URL=

# Cost-optimized defaults (override per role if needed)
AGENTIC_REASONING_MODEL=groq/llama-3.1-8b-instant
AGENTIC_STRUCTURED_MODEL=groq/llama-3.1-8b-instant
AGENTIC_CODE_MODEL=groq/llama-3.1-8b-instant
AGENTIC_LLM_TEMPERATURE=0.1

# Provider API keys (set only the one you use)
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Ollama base URL only used when AGENTIC_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Workspace configuration
WORKSPACE_BASE_PATH=C:/Users/CalebNaidoo/document_ai_agentic_testing/workspaces

# Evidence store path
EVIDENCE_STORE_PATH=C:/Users/CalebNaidoo/document_ai_agentic_testing/data/DocumentAI_EvidenceStore.xlsx

# Logging
LOG_LEVEL=INFO

# FastAPI deployment token (for local/API mode)
AGENTIC_API_TOKEN=replace-with-strong-token
